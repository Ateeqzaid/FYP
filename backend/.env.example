# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Detection Configuration (optional - defaults shown)
# DETECTION_FRAME_WIDTH=640
# DETECTION_FRAME_HEIGHT=480
# DETECTION_FACE_DETECTION_CONFIDENCE=0.5
# DETECTION_NO_FACE_TIMEOUT_SECONDS=10
# DETECTION_MULTIPLE_FACES_TIMEOUT_SECONDS=5
# DETECTION_PHONE_CONFIDENCE_THRESHOLD=0.4
# DETECTION_PHONE_IGNORE_SECONDS=2.0
# DETECTION_HEAD_POSE_THRESHOLD_DEGREES=25
# DETECTION_HEAD_POSE_SUSPICIOUS_SECONDS=5
# DETECTION_HEAD_POSE_CONSECUTIVE_FRAMES=5
# DETECTION_EYE_GAZE_THRESHOLD_RATIO=0.42
# DETECTION_EYE_GAZE_SUSPICIOUS_SECONDS=5
# DETECTION_EYE_BLINK_THRESHOLD_RATIO=0.20
# DETECTION_EYE_BLINK_FRAMES_TOLERANCE=3
# DETECTION_VIOLATION_COOLDOWN_SECONDS=15
